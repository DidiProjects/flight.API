NODE_ENV=development
HOST=0.0.0.0
PORT=3011

PG_HOST=localhost
PG_PORT=5432
PG_USER=admin
PG_PASSWORD=admin123
PG_DB=dev-flightDB

JWT_SECRET=change-this-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

SCRAPE_INTERVAL_MS=300000
SCRAPE_INTERVAL_JITTER_MS=60000
# Jobs por companhia por tick = sessões simultâneas no mesmo IP/site. Mantenha
# baixo (1) para evitar detecção de bot; só suba com rotação de IP / cap por site.
SCRAPE_DISPATCH_BATCH=1
# Teto de jobs em voo (backpressure): a API não despacha além disto.
SCRAPE_MAX_IN_FLIGHT=6
SCRAPING_API_URL=http://192.168.122.224:3000
SCRAPING_API_KEY=your-scraping-api-key
FLIGHT_API_KEY=your-callback-shared-key

# Tempo real (WS hub ← workers + SSE → admin). FLIGHT_API_KEY também autentica
# o worker no upgrade do WebSocket (/realtime/worker?key=...). 'false' desliga.
REALTIME_ENABLED=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="flight.API <noreply@example.com>"

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_INITIAL=changeme123

API_BASE_URL=http://localhost:3011/flight
FRONTEND_URL=http://localhost:3000

LOG_LEVEL=info

# Grafana Loki (optional — leave empty to disable log shipping)
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=
